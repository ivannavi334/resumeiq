# === Application ===
APP_NAME=ResumeIQ
APP_VERSION=1.0.0
DEBUG=false
ENVIRONMENT=production

# === Server ===
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=https://your-app.vercel.app

# === Database ===
DATABASE_URL=postgresql://user:password@host:5432/resumeiq

# === Redis (optional) ===
REDIS_URL=redis://localhost:6379/0

# === Security ===
SECRET_KEY=replace-with-32-plus-char-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_URL=https://your-project.supabase.co

# === OpenAI ===
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=4096

# === Stripe ===
STRIPE_SECRET_KEY=sk_live_...
STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_ENTERPRISE=price_...

# === AWS S3 (unused, reserved) ===
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_S3_BUCKET=resumeiq-files

# === Email (SMTP, unused) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=ResumeIQ <noreply@resumeiq.com>

# === Rate Limiting ===
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# === Plan Limits ===
FREE_PLAN_ANALYSES_PER_MONTH=3
PRO_PLAN_ANALYSES_PER_MONTH=50
ENTERPRISE_PLAN_ANALYSES_PER_MONTH=999999
